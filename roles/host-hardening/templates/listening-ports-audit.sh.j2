#!/bin/bash
# Port allow-list audit. Compares what listens on this host with the lists in
# inventory/host_vars/<host>.yml and writes the result where the host's metrics collector reads it:
#
#   host_unexpected_listener{proto,port,process,scope} N   one line per listener that is not listed;
#                                                          N = the runs in a row that saw it
#   host_port_audit_unexpected{scope}                      how many, per scope (0 when all is well)
#   host_port_audit_last_run_timestamp_seconds             when the audit last ran
#
# scope is "loopback" for a socket bound to 127.0.0.0/8 or ::1 and "network" for everything else.
# The alert UnexpectedListenerOnNode fires on "network" entries only: a loopback socket cannot be
# reached from another machine, so it is recorded, not mailed. It also waits for N = 2, a listener
# that two runs in a row found.
#
# A list entry is one port (443) or a range ("21640:22415"). Either may name the process the port
# belongs to ("5353@roomlerd"): the entry then covers the port only while that process holds it,
# and the same port under any other process is reported. The name is the one a report shows in
# its process label, compared whole.
#
# For UDP there is a second list, EPHEMERAL_UDP: a process named there may also hold sockets
# inside the kernel's ephemeral port range. A resolver or a NAT-traversal daemon sends from a
# random port and that port is another one after every restart, so it cannot be written down as
# a number.
#
# Rendered from roles/host-hardening/templates/listening-ports-audit.sh.j2; the lists come from
# inventory, never from an edit of this file. Tests (they need nothing but bash and awk):
#   bash roles/host-hardening/tests/listening-ports-audit.test.sh

set -uo pipefail

EXPECTED_TCP="{{ host_hardening_expected_tcp | default([]) | join(' ') }}"
EXPECTED_UDP="{{ host_hardening_expected_udp | default([]) | join(' ') }}"
EPHEMERAL_UDP="{{ host_hardening_expected_udp_ephemeral | default([]) | join(' ') }}"

OUT_DIR=${LPA_OUT_DIR:-/var/lib/node_exporter/textfile_collector}
OUTPUT="$OUT_DIR/host_unexpected_listener.prom"

# The sockets of one protocol, one per line, as `ss` prints them. The two *_FILE variables and
# LPA_EPHEMERAL_RANGE exist for the tests.
read_sockets() {
  if [ "$1" = tcp ]; then
    if [ -n "${LPA_SS_TCP_FILE:-}" ]; then cat "$LPA_SS_TCP_FILE"; else ss -H -tlnp; fi
  else
    if [ -n "${LPA_SS_UDP_FILE:-}" ]; then cat "$LPA_SS_UDP_FILE"; else ss -H -ulnp; fi
  fi
}

ephemeral=${LPA_EPHEMERAL_RANGE:-$(cat /proc/sys/net/ipv4/ip_local_port_range 2>/dev/null)}
# shellcheck disable=SC2086
set -- $ephemeral
eph_lo=${1:-32768}
eph_hi=${2:-60999}

# audit <tcp|udp> <expected list>: one metric line per socket that is not expected.
audit() {
  read_sockets "$1" | awk -v proto="$1" -v list="$2" -v roam="$EPHEMERAL_UDP" -v elo="$eph_lo" -v ehi="$eph_hi" '
    # Is this socket on the list? An entry that ends in @process is for that process alone: under
    # any other name it is passed over, and so is one whose process part is empty.
    function expected(port, name,   n, i, a, r, at, spec) {
      n = split(list, a, " ")
      for (i = 1; i <= n; i++) {
        spec = a[i]
        at = index(spec, "@")
        if (at > 0) {
          if (substr(spec, at + 1) != name) continue
          spec = substr(spec, 1, at - 1)
        }
        if (index(spec, ":") > 0) {
          split(spec, r, ":")
          if (port + 0 >= r[1] + 0 && port + 0 <= r[2] + 0) return 1
        } else if (spec + 0 == port + 0) {
          return 1
        }
      }
      return 0
    }
    function may_roam(name,   n, i, a) {
      n = split(roam, a, " ")
      for (i = 1; i <= n; i++) {
        if (a[i] == name) return 1
      }
      return 0
    }
    {
      # ss -H: State Recv-Q Send-Q Local:Port Peer:Port [users:(("name",pid=..,fd=..))]
      addr = $4
      if (!match(addr, /:[0-9]+$/)) next
      port = substr(addr, RSTART + 1)
      addr = substr(addr, 1, RSTART - 1)
      sub(/%.*$/, "", addr)
      gsub(/\[/, "", addr)
      gsub(/\]/, "", addr)

      scope = "network"
      if (addr ~ /^127\./ || addr == "::1" || addr ~ /^::ffff:127\./) scope = "loopback"

      # A socket the kernel holds itself (a tunnel, for one) has no process.
      name = "kernel"
      if (match($0, /users:\(\("[^"]+"/)) name = substr($0, RSTART + 9, RLENGTH - 10)
      # The name ends up inside a label value, and a process chooses its own name.
      gsub(/[^A-Za-z0-9._:@+-]/, "_", name)

      if (expected(port, name)) next
      if (proto == "udp" && port + 0 >= elo + 0 && port + 0 <= ehi + 0 && may_roam(name)) next

      printf "host_unexpected_listener{proto=\"%s\",port=\"%s\",process=\"%s\",scope=\"%s\"} 1\n", proto, port, name, scope
    }
  '
}

# Written beside the result and renamed over it, so the collector never reads half a file. It
# reads *.prom only, so neither name below is ever picked up.
tmp=$(mktemp "$OUT_DIR/.host_unexpected_listener.XXXXXX") || exit 1
trap 'rm -f "$tmp" "$tmp.body" "$tmp.seen"' EXIT

{ audit tcp "$EXPECTED_TCP" && audit udp "$EXPECTED_UDP"; } | sort -u > "$tmp.body"
if [ "${PIPESTATUS[0]}" -ne 0 ]; then
  # No list of sockets is not "nothing unexpected": keep the old result, and let its age show.
  echo "audit failed: the sockets could not be listed" >&2
  exit 1
fi

on_network=$(grep -c 'scope="network"' "$tmp.body")
on_loopback=$(grep -c 'scope="loopback"' "$tmp.body")

# The value of a line is the number of runs in a row that saw the listener, and the last result
# is the memory: 1 on the first sighting, one more every run it is still there. The alert asks
# for 2, so a socket that was open at the moment of one run and gone by the next mails nobody.
awk -v last="$OUTPUT" '
  BEGIN {
    while ((getline line < last) > 0) {
      if (line ~ /^host_unexpected_listener[{]/) {
        split(line, part, " ")
        runs[part[1]] = part[2] + 0
      }
    }
  }
  { print $1, runs[$1] + 1 }
' "$tmp.body" > "$tmp.seen"

{
  echo "# HELP host_unexpected_listener Runs in a row that saw a listener which is not on this host's allow-list"
  echo "# TYPE host_unexpected_listener gauge"
  cat "$tmp.seen"
  echo "# HELP host_port_audit_unexpected Listeners that are not on the allow-list, by scope"
  echo "# TYPE host_port_audit_unexpected gauge"
  echo "host_port_audit_unexpected{scope=\"network\"} $on_network"
  echo "host_port_audit_unexpected{scope=\"loopback\"} $on_loopback"
  echo "# HELP host_port_audit_last_run_timestamp_seconds When the port audit last ran"
  echo "# TYPE host_port_audit_last_run_timestamp_seconds gauge"
  echo "host_port_audit_last_run_timestamp_seconds $(date +%s)"
} > "$tmp"

chmod 0644 "$tmp"
mv "$tmp" "$OUTPUT"
echo "audit complete; $on_network unexpected on the network, $on_loopback on loopback only"
