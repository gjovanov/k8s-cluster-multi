#!/bin/bash
set -e

DNAT_CHAIN="COTURN_DNAT"
OUTPUT_DNAT_CHAIN="COTURN_OUTPUT_DNAT"
SNAT_CHAIN="COTURN_SNAT"

# Get this host's rules
PUBLIC_IP="{{ coturn_dnat_rules[host_name].public_ip }}"
{% if coturn_dnat_rules[host_name].secondary_ip is defined %}
SECONDARY_IP="{{ coturn_dnat_rules[host_name].secondary_ip }}"
{% endif %}
DEST_IP="{{ coturn_dnat_rules[host_name].dest_ip }}"
VM_SUBNET="{{ coturn_dnat_rules[host_name].vm_subnet }}"

# --- FORWARD rules for DNAT traffic (public internet -> VM via virbr) ---
# libvirt's LIBVIRT_FWI chain blocks NEW connections to VMs by default;
# these rules allow DNAT'd traffic to reach the VMs
iptables -D FORWARD -d $VM_SUBNET -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -s $VM_SUBNET -j ACCEPT 2>/dev/null || true
iptables -I FORWARD 1 -d $VM_SUBNET -j ACCEPT
iptables -I FORWARD 2 -s $VM_SUBNET -j ACCEPT

# --- TTL restoration (mangle PREROUTING - runs BEFORE the routing decision) ---
# coturn emits its UDP replies with TTL=1. Harmless when the client is on the
# same L2, but here EVERY reply must be FORWARDED by this bare-metal host out
# to the internet, and forwarding decrements TTL 1 -> 0, so the kernel drops
# the packet before it ever reaches the FORWARD chain.
#
# Symptom (diagnosed 2026-08-06): STUN/TURN over UDP was one-way. Requests were
# DNAT'd into the VM and coturn answered, but no reply ever egressed. No overlay
# node could gather a server-reflexive candidate, so srflx_endpoints was empty
# fleet-wide, every pair read as "both UDP-blocked", and the whole mesh fell
# back to the DERP carrier - its slowest tier. TCP was unaffected only because
# HAProxy terminates :443/:5349 host-local and never traverses this path.
#
# mangle PREROUTING is the only hook early enough to save it: raw PREROUTING
# sees the reply, the routing decision kills it, and FORWARD + nat POSTROUTING
# never see it at all (verified with simultaneous per-hook LOG counters:
# raw=3, mangle-FORWARD=0, filter-FORWARD=0, nat-POSTROUTING=0).
TTL_CHAIN="COTURN_TTL"
iptables -t mangle -N "$TTL_CHAIN" 2>/dev/null || iptables -t mangle -F "$TTL_CHAIN"
iptables -t mangle -C PREROUTING -j "$TTL_CHAIN" 2>/dev/null || \
  iptables -t mangle -I PREROUTING 1 -j "$TTL_CHAIN"
{% for port in coturn_dnat_rules[host_name].ports %}
iptables -t mangle -A "$TTL_CHAIN" -s "$DEST_IP" -p udp --sport {{ port }} -j TTL --ttl-set 64
{% endfor %}
{% for range in coturn_dnat_rules[host_name].port_ranges %}
iptables -t mangle -A "$TTL_CHAIN" -s "$DEST_IP" -p udp --sport {{ range }} -j TTL --ttl-set 64
{% endfor %}

# Create/flush DNAT chain
iptables -t nat -N "$DNAT_CHAIN" 2>/dev/null || iptables -t nat -F "$DNAT_CHAIN"
iptables -t nat -C PREROUTING -j "$DNAT_CHAIN" 2>/dev/null || \
  iptables -t nat -I PREROUTING 1 -j "$DNAT_CHAIN"

# Create/flush OUTPUT DNAT chain
iptables -t nat -N "$OUTPUT_DNAT_CHAIN" 2>/dev/null || iptables -t nat -F "$OUTPUT_DNAT_CHAIN"
iptables -t nat -C OUTPUT -j "$OUTPUT_DNAT_CHAIN" 2>/dev/null || \
  iptables -t nat -I OUTPUT 1 -j "$OUTPUT_DNAT_CHAIN"

# Create/flush SNAT chain
iptables -t nat -N "$SNAT_CHAIN" 2>/dev/null || iptables -t nat -F "$SNAT_CHAIN"
iptables -t nat -C POSTROUTING -j "$SNAT_CHAIN" 2>/dev/null || \
  iptables -t nat -I POSTROUTING 1 -j "$SNAT_CHAIN"

{% for proto in coturn_dnat_rules[host_name].protocols %}
# DNAT for {{ proto }} ports (PRIMARY_IP{% if coturn_dnat_rules[host_name].secondary_ip is defined %} + SECONDARY_IP{% endif %})
{% for port in coturn_dnat_rules[host_name].ports %}
iptables -t nat -A "$DNAT_CHAIN" -d "$PUBLIC_IP" -p {{ proto }} --dport {{ port }} -j DNAT --to-destination "$DEST_IP":{{ port }}
iptables -t nat -A "$OUTPUT_DNAT_CHAIN" -d "$PUBLIC_IP" -p {{ proto }} --dport {{ port }} -j DNAT --to-destination "$DEST_IP":{{ port }}
{% if coturn_dnat_rules[host_name].secondary_ip is defined %}
iptables -t nat -A "$DNAT_CHAIN" -d "$SECONDARY_IP" -p {{ proto }} --dport {{ port }} -j DNAT --to-destination "$DEST_IP":{{ port }}
iptables -t nat -A "$OUTPUT_DNAT_CHAIN" -d "$SECONDARY_IP" -p {{ proto }} --dport {{ port }} -j DNAT --to-destination "$DEST_IP":{{ port }}
{% endif %}
{% endfor %}
{% for range in coturn_dnat_rules[host_name].port_ranges %}
iptables -t nat -A "$DNAT_CHAIN" -d "$PUBLIC_IP" -p {{ proto }} --dport {{ range }} -j DNAT --to-destination "$DEST_IP":{{ range | replace(':', '-') }}
iptables -t nat -A "$OUTPUT_DNAT_CHAIN" -d "$PUBLIC_IP" -p {{ proto }} --dport {{ range }} -j DNAT --to-destination "$DEST_IP":{{ range | replace(':', '-') }}
{% if coturn_dnat_rules[host_name].secondary_ip is defined %}
iptables -t nat -A "$DNAT_CHAIN" -d "$SECONDARY_IP" -p {{ proto }} --dport {{ range }} -j DNAT --to-destination "$DEST_IP":{{ range | replace(':', '-') }}
iptables -t nat -A "$OUTPUT_DNAT_CHAIN" -d "$SECONDARY_IP" -p {{ proto }} --dport {{ range }} -j DNAT --to-destination "$DEST_IP":{{ range | replace(':', '-') }}
{% endif %}
{% endfor %}
{% if coturn_dnat_rules[host_name].primary_redirects is defined %}
# PRIMARY-IP port redirects. A redirect with `proto` applies to that protocol
# only (tcp :443 → TURNS :5349, udp :443 → plain TURN/STUN :3478 — the DTLS
# listener on 5349 silently drops plain-UDP clients); without `proto` it
# applies to every protocol in `protocols`.
{% for redir in coturn_dnat_rules[host_name].primary_redirects %}
{% if redir.proto is not defined or redir.proto == proto %}
iptables -t nat -A "$DNAT_CHAIN" -d "$PUBLIC_IP" -p {{ proto }} --dport {{ redir.dport }} -j DNAT --to-destination "$DEST_IP":{{ redir.tport }}
iptables -t nat -A "$OUTPUT_DNAT_CHAIN" -d "$PUBLIC_IP" -p {{ proto }} --dport {{ redir.dport }} -j DNAT --to-destination "$DEST_IP":{{ redir.tport }}
{% endif %}
{% endfor %}
{% endif %}
{% if coturn_dnat_rules[host_name].secondary_ip is defined and coturn_dnat_rules[host_name].secondary_redirects is defined %}
# SECONDARY-IP port redirects (same per-`proto` semantics as the primary
# block above).
{% for redir in coturn_dnat_rules[host_name].secondary_redirects %}
{% if redir.proto is not defined or redir.proto == proto %}
iptables -t nat -A "$DNAT_CHAIN" -d "$SECONDARY_IP" -p {{ proto }} --dport {{ redir.dport }} -j DNAT --to-destination "$DEST_IP":{{ redir.tport }}
iptables -t nat -A "$OUTPUT_DNAT_CHAIN" -d "$SECONDARY_IP" -p {{ proto }} --dport {{ redir.dport }} -j DNAT --to-destination "$DEST_IP":{{ redir.tport }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

# Skip SNAT for internal cluster traffic (WireGuard mesh)
iptables -t nat -A "$SNAT_CHAIN" -d 10.10.0.0/16 -j RETURN

# Dual-IP fix (overlay/QUIC reliability): replies for connections that arrived
# on the SECONDARY public IP must be SNAT'd back to the SECONDARY, not the
# primary. The client allocated against the secondary (what coturn DNS
# publishes) and drops return traffic coming from any other source IP, which
# silently broke cross/same-worker relay on the dual-IP host. `--ctorigdst`
# matches the pre-DNAT IP the client targeted; must precede the PRIMARY_IP
# rules below (first match wins in the chain).
{% if coturn_dnat_rules[host_name].secondary_ip is defined %}
iptables -t nat -A "$SNAT_CHAIN" -s "$DEST_IP" -m conntrack --ctorigdst "$SECONDARY_IP" -j SNAT --to-source "$SECONDARY_IP"
{% endif %}

# SNAT for relay/RTC traffic (preserve source ports)
{% for range in coturn_dnat_rules[host_name].port_ranges %}
iptables -t nat -A "$SNAT_CHAIN" -s "$DEST_IP" -p udp --sport {{ range }} -j SNAT --to-source "$PUBLIC_IP"
iptables -t nat -A "$SNAT_CHAIN" -s "$DEST_IP" -p tcp --sport {{ range }} -j SNAT --to-source "$PUBLIC_IP"
{% endfor %}

# General SNAT for non-relay outbound (internet traffic only)
iptables -t nat -A "$SNAT_CHAIN" -s "$DEST_IP" ! -d $VM_SUBNET -j SNAT --to-source "$PUBLIC_IP"

echo "iptables rules applied for {{ host_name }} ($PUBLIC_IP -> $DEST_IP)"
