#!/usr/bin/env bash
# vmtest-audit — capacity preflight for the FR-61 throwaway install-test VMs.
# Installed by roles/vmtest-host; run by roomler-ai-deploy/vmtest/vmtest.sh
# before every lane, and by hand when deciding whether a k8s VM shrink is
# actually needed (see roles/vmtest-host/README.md — the answer is usually no:
# lanes run sequentially, one VM per host, <=8 GiB peak).
#
# Prints a report and exits non-zero when the host cannot take a VM of the
# requested size. Usage: vmtest-audit [needed_mib] [needed_gb_disk]
#
# RAM is a commitment, not a snapshot. A guest's untouched memory reads as
# available until the guest touches it, so MemAvailable alone says yes to a host
# that is already overcommitted. That is how a lab boot got k8s-worker-2's qemu
# OOM-killed on zeus on 2026-10-31: running guests were allocated more than the
# host's RAM while this check still passed. The host therefore also has to fit
# everything running at full size, plus the new guest, plus its own reserve.
set -eu

NEED_MIB="${1:-8192}"
NEED_GB="${2:-40}"
VMTEST_DIR="{{ vmtest_dir }}"
# What the host keeps for itself: the kernel, libvirtd, qemu's overhead per VM.
# 9540 MiB puts zeus's budget at 116 GiB: its two k8s VMs plus 44 GiB of guests.
HOST_RESERVE_MIB="${VMTEST_HOST_RESERVE_MIB:-9540}"

echo "== vmtest-audit @ $(hostname) $(date -u +%FT%TZ) =="

# RAM: MemAvailable is the honest number (page cache reclaims under pressure).
avail_mib=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
total_mib=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
echo "ram: ${avail_mib} MiB available of ${total_mib} MiB"

# What libvirt has committed (the k8s VMs + any leftover vmtest guests).
echo "-- libvirt domains --"
virsh list --all --name | sed '/^$/d' | while read -r dom; do
  mem_kib=$(virsh dominfo "$dom" | awk '/Used memory/{print $3}')
  state=$(virsh domstate "$dom")
  printf '  %-24s %-10s %6d MiB\n' "$dom" "$state" "$((mem_kib / 1024))"
done

# Every running or paused guest at its full size, whoever started it.
committed_mib=0
while read -r dom; do
  mem_kib=$(virsh dominfo "$dom" | awk '/Used memory/{print $3}')
  committed_mib=$((committed_mib + mem_kib / 1024))
done < <(virsh list --name | sed '/^$/d')
# A lane whose second guest boots late holds its room here: one file per lane,
# holding MiB, removed by the lane. A file older than 12 h is a crashed lane's.
reserved_mib=0
while read -r f; do
  r=$(tr -dc '0-9' < "$f")
  reserved_mib=$((reserved_mib + ${r:-0}))
done < <(find "$VMTEST_DIR/reserved.d" -maxdepth 1 -type f -mmin -720 2>/dev/null)
committed_mib=$((committed_mib + reserved_mib))
budget_mib=$((total_mib - HOST_RESERVE_MIB))
echo "committed: ${committed_mib} MiB to running guests and ${reserved_mib} MiB of that reserved, +${NEED_MIB} MiB for this one, budget ${budget_mib} MiB (${total_mib} MiB less a ${HOST_RESERVE_MIB} MiB reserve)"

# Leftover vmtest guests are a bug in a previous run's teardown — name them.
leftovers=$(virsh list --all --name | grep '^vmtest-' || true)
if [ -n "$leftovers" ]; then
  echo "WARN: leftover vmtest domains (a prior run did not clean up):"
  echo "$leftovers" | sed 's/^/  /'
fi

free_gb=$(df -BG --output=avail "$VMTEST_DIR" 2>/dev/null | tail -1 | tr -dc '0-9')
echo "disk: ${free_gb}G free on the filesystem holding ${VMTEST_DIR}"

cores=$(nproc)
load=$(cut -d' ' -f1 /proc/loadavg)
echo "cpu: ${cores} cores, load ${load} (vCPUs are time-shared — RAM is the only hard commit)"

fail=0
if [ "$avail_mib" -lt "$NEED_MIB" ]; then
  echo "FAIL: need ${NEED_MIB} MiB available RAM, have ${avail_mib} MiB."
  echo "      Before shrinking any k8s VM, read roles/vmtest-host/README.md —"
  echo "      sequential scheduling usually makes the shrink unnecessary."
  fail=1
fi
if [ "$((committed_mib + NEED_MIB))" -gt "$budget_mib" ]; then
  echo "FAIL: running guests plus this one need $((committed_mib + NEED_MIB)) MiB at full size, over the ${budget_mib} MiB budget."
  echo "      Stop a guest first. The MemAvailable figure above does not make this safe:"
  echo "      a guest that has not refilled yet will, and the kernel then OOM-kills the"
  echo "      largest VM, which on this host can be a k8s node."
  fail=1
fi
if [ "$free_gb" -lt "$NEED_GB" ]; then
  echo "FAIL: need ${NEED_GB}G free disk under ${VMTEST_DIR}, have ${free_gb}G."
  fail=1
fi
[ "$fail" -eq 0 ] && echo "OK: host can take a ${NEED_MIB} MiB / ${NEED_GB}G guest."
exit "$fail"
